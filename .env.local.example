# 作品集 AI 分身聊聊功能用的環境變數。
# 本機開發：複製成 .env.local 並填值（.env.local 已被 gitignore）。
# 線上：在 Vercel → Project → Settings → Environment Variables 設定。

# --- LLM（訪客一律用 Gemini，免費）---
# Gemini 金鑰（免費、免綁卡）：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 可選，預設 gemini-2.5-flash-lite（每日免費額度較高）
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Claude（選用，只有輸入管理密鑰的人才能切換）---
# 申請（需綁卡儲值）：https://console.anthropic.com/
ANTHROPIC_API_KEY=
# 可選，預設 claude-haiku-4-5（最便宜）；要更高品質可改 claude-opus-4-8
CLAUDE_MODEL=claude-haiku-4-5

# 切換到 Claude 需要的管理密鑰（自己設一組）。沒設則沒人能切到 Claude。
CHAT_ADMIN_TOKEN=

# --- 對話紀錄（選用，寫進 Supabase）---
# 沒填這兩個就不記錄。需先在 Supabase 建一張 portfolio_chat_logs 表（見 README）。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
